{
  "name": "steuertools-functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions for SteuerTools",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc && node ../scripts/generate-mcp-automations.js",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:selfhost": "vitest run --config vitest.selfhost.config.ts",
    "db:generate": "drizzle-kit generate",
    "selfhost:api": "vite-node --config vitest.selfhost.config.ts src/selfhost/server.ts",
    "selfhost:import": "vite-node --config vitest.selfhost.config.ts src/selfhost/migrate-cli-run.ts import",
    "selfhost:verify": "vite-node --config vitest.selfhost.config.ts src/selfhost/migrate-cli-run.ts verify",
    "check:document-types": "vite-node scripts/check-document-type-corpus.ts",
    "selfhost:export": "vite-node scripts/export-firebase-dump.ts",
    "selfhost:rewrite-urls": "vite-node --config vitest.selfhost.config.ts scripts/rewrite-download-urls.ts",
    "selfhost:strip-line-item-fields": "vite-node --config vitest.selfhost.config.ts scripts/strip-line-item-fields.ts",
    "selfhost:gross-up-net-line-items": "vite-node --config vitest.selfhost.config.ts scripts/gross-up-net-line-items.ts",
    "selfhost:decode-partner-name-entities": "vite-node --config vitest.selfhost.config.ts scripts/decode-partner-name-entities.ts",
    "selfhost:migrate-file-hash": "vite-node --config vitest.selfhost.config.ts scripts/migrate-file-hash.ts",
    "selfhost:migrate-transaction-type": "vite-node --config vitest.selfhost.config.ts scripts/migrate-transaction-type.ts",
    "selfhost:remove-local-file-hints": "vite-node --config vitest.selfhost.config.ts scripts/remove-local-file-hints.ts",
    "selfhost:collapse-file-connections": "vite-node --config vitest.selfhost.config.ts scripts/collapse-file-connections.ts",
    "selfhost:reextract-sepa-debit-dates": "vite-node --config vitest.selfhost.config.ts scripts/reextract-sepa-debit-dates.ts",
    "selfhost:rematch-stretched-windows": "vite-node --config vitest.selfhost.config.ts scripts/rematch-stretched-windows.ts",
    "selfhost:repair-rescored-connections": "vite-node --config vitest.selfhost.config.ts scripts/repair-rescored-connections.ts",
    "selfhost:repair-mail-file-sizes": "vite-node --config vitest.selfhost.config.ts scripts/repair-mail-file-sizes.ts",
    "selfhost:repair-inbound-daily-limits": "vite-node --config vitest.selfhost.config.ts scripts/repair-inbound-daily-limits.ts",
    "selfhost:report-swept-hand-corrected-directions": "vite-node --config vitest.selfhost.config.ts scripts/report-swept-hand-corrected-directions.ts"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "@google-cloud/vertexai": "^1.12.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@react-pdf/renderer": "^4.9.0",
    "@sendgrid/mail": "^8.1.6",
    "@simplewebauthn/server": "^13.3.1",
    "@simplewebauthn/types": "^12.0.0",
    "@sparticuz/chromium": "^149.0.0",
    "archiver": "^8.0.0",
    "better-auth": "~1.6.33",
    "busboy": "^1.6.0",
    "cologne-phonetic": "^1.1.1",
    "drizzle-orm": "^0.45.3",
    "express": "^4.22.2",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "imapflow": "^1.4.7",
    "jose": "^6.2.12",
    "mailparser": "^3.9.28",
    "minio": "^8.0.7",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.10",
    "otplib": "^13.5.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "puppeteer-core": "^24.36.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "resend": "^6.30.0",
    "soap": "^1.13.1",
    "stripe": "^20.3.1",
    "unzipper": "^0.12.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/archiver": "^8.0.0",
    "@types/busboy": "^1.5.4",
    "@types/express": "^4.17.25",
    "@types/mailparser": "^3.4.4",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/soap": "^0.21.0",
    "@types/unzipper": "^0.10.11",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.3",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.9"
  },
  "private": true,
  "overrides": {
    "gaxios": "^7.3.0",
    "gcp-metadata": "^8.1.4"
  }
}
