# Hetzner deployment — copy to .env ON THE SERVER and fill in. NEVER commit the filled file.
#
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml \
#     --env-file .env up -d --build
#
# Generate every CHANGE_ME with:  openssl rand -base64 36
#
# Differs from .env.example in two ways: it uses the BUILT-IN Better Auth path
# rather than external OIDC, and it sets the Caddy hostnames.

# --- Public hostnames (Caddy provisions a cert for each) ---
FIBUKI_WEB_HOST=fibuki.com
FIBUKI_API_HOST=new-api.fibuki.com

# --- Host port publishing ---
# Both containers publish on 127.0.0.1 by default, because Docker's own iptables
# rules bypass ufw/firewalld: a 0.0.0.0 bind is reachable from the internet over
# plain HTTP no matter what the host firewall says. Caddy is the only public
# listener and reaches the services over the compose network.
#
# Set this ONLY when the reverse proxy runs on a DIFFERENT host — the symptom is
# 502 from the proxy while every container is healthy and curl on the box
# answers 200. Name the private interface address the proxy connects to
# (e.g. 10.0.0.5). Do not put 0.0.0.0 here.
# FIBUKI_BIND_ADDR=127.0.0.1

# --- Postgres (Firestore-shim JSONB store) ---
POSTGRES_USER=fibuki
POSTGRES_PASSWORD=CHANGE_ME_pg
POSTGRES_DB=fibuki
# Pool ceiling for the shim (see firestore-shim.ts). Must stay under Postgres'
# max_connections, which is 100 by default.
POSTGRES_MAX_CONNECTIONS=25

# --- MinIO / S3 (storage-shim backend; internal to the compose network only) ---
FIBUKI_S3_ACCESS_KEY=fibuki
FIBUKI_S3_SECRET_KEY=CHANGE_ME_minio
FIBUKI_STORAGE_BUCKET=fibuki-selfhost

# --- Host URLs (must match the hostnames above, with scheme) ---
FIBUKI_PUBLIC_URL=https://new-api.fibuki.com
FIBUKI_WEB_ORIGIN=https://fibuki.com

# --- Auth: BUILT-IN (Better Auth) ---
#
# Deliberately NOT OIDC. The OIDC verifier maps the IdP's `sub` claim straight to
# uid (oidc-verifier.ts). The migration importer is uid-PRESERVING: it keeps the
# original Firebase uids. An Authentik-issued `sub` is not a Firebase uid, so
# under OIDC every migrated record would be owned by a uid nobody can sign in as,
# and the data would import cleanly while appearing empty.
#
# Better Auth keeps the uid contract intact. It also avoids a fifth container.
#
# Leave OIDC_ISSUER UNSET — server.ts checks it first and, if present, leaves the
# built-in auth unmounted entirely.
FIBUKI_AUTH_SECRET=CHANGE_ME_auth_secret
FIBUKI_AUTH_ISSUER=https://new-api.fibuki.com
# NEVER set FIBUKI_DEV_UID here — it authenticates every bearer token as one user.

# --- SMTP (mailer-shim) ---
#
# Configured for Resend, which the Firebase build already uses
# (functions/src/utils/mailer.ts, RESEND_API_KEY) — so no new provider account
# and noreply@fibuki.com is already a verified sender.
#
# Resend authenticates over SMTP as the literal username "resend" with the API
# key as the password. The username is therefore NOT an address, which is why
# FIBUKI_SMTP_FROM has to be set: without it the shim pins From to the username
# and emits "FiBuKI <resend>", which is undeliverable.
#
# For a mailbox provider instead (Migadu, Fastmail, Google Workspace), set USER
# to the mailbox address and leave FIBUKI_SMTP_FROM unset — the shim then aligns
# From with the authenticated mailbox, which those providers require.
# Port 2465, not the usual 465: Hetzner Cloud blocks outbound 25 and 465, so 465
# fails with a bare ETIMEDOUT on CONN and nothing more useful. Resend publishes
# 2465 (implicit TLS) and 2587 (STARTTLS) for exactly this; both are reachable, as
# is plain 587. Verified from the nbg1 host 2026-07-29.
FIBUKI_SMTP_HOST=smtp.resend.com
FIBUKI_SMTP_PORT=2465
FIBUKI_SMTP_SECURE=true
FIBUKI_SMTP_USER=resend
FIBUKI_SMTP_PASS=CHANGE_ME_resend_api_key
FIBUKI_SMTP_FROM=noreply@fibuki.com
FIBUKI_SMTP_FROM_NAME=FiBuKI

# --- Web build args (NEXT_PUBLIC_* are inlined at BUILD time — rebuild on change) ---
NEXT_PUBLIC_FIBUKI_API_URL=https://new-api.fibuki.com
# 5000ms rather than the 2500 default: every onSnapshot is a poll, so this halves
# steady-state request volume. On a tax tool the difference is not perceptible.
NEXT_PUBLIC_FIBUKI_POLL_MS=5000
# Unset under Better Auth — present so a later OIDC switch is a one-file edit.
NEXT_PUBLIC_OIDC_ISSUER=
NEXT_PUBLIC_OIDC_CLIENT_ID=
NEXT_PUBLIC_OIDC_SCOPE=
NEXT_PUBLIC_OIDC_ADMIN_GROUP=
NEXT_PUBLIC_OIDC_REDIRECT_URI=

# --- AI providers (selfhost/ai/config.ts) ---
#
# Gemini needs NO Google Cloud service account here: the Generative Language API
# takes a plain API key from https://aistudio.google.com/apikey, and speaks the
# same JSON as Vertex AI. The Firebase build still uses Vertex with its ambient
# service account; only the self-host stack routes through the adapter.
FIBUKI_AI_PROVIDER=gemini
FIBUKI_GEMINI_API_KEY=CHANGE_ME_gemini_api_key

# The sidebar chat is the exception to "AI runs on fibuki-api": its LangGraph agent
# runs inside fibuki-web (app/api/chat), so the key above is ALSO passed to that
# container. It does not go through selfhost/ai routing — FIBUKI_AI_ROUTE_* has no
# effect on chat. Which model chat uses is set here instead:
#
# Google retires model ids for NEW API-key consumers while Vertex keeps serving
# them, so the id pinned in types/ai-usage.ts ("gemini-2.5-flash") can answer
#   404 ... is not found for API version v1beta
# on a key that works fine for everything else. "gemini-flash-latest" tracks the
# current flash model and avoids re-breaking on the next retirement; pin an exact
# id instead if you want reproducible behaviour over staying current.
FIBUKI_CHAT_MODEL=gemini-flash-latest

# Per-model routing. Call sites never inline model ids — they use the roles in
# functions/src/utils/models.ts, where geminiLite covers extraction, column
# matching and pattern learning, and geminiFlash covers company lookup and
# partner matching. So routing on the model id is routing per task.
#
# Example: keep extraction on Gemini, move the heavier reasoning to Claude.
#   FIBUKI_AI_ROUTE_gemini_2_5_flash=anthropic:claude-haiku-4-5-20251001
# Dots and dashes in the model id become underscores.
#
# NOTE: cost accounting (MODEL_PRICING) is keyed on the model the CALL SITE asked
# for, so a cross-provider override prices the call at the requested model's rate.
# Fine for like-for-like, misleading otherwise.
# FIBUKI_ANTHROPIC_API_KEY=
#
# Front Anthropic with a gateway or egress proxy (LiteLLM, Cloudflare AI Gateway,
# a corporate proxy). Set it on BOTH containers — the API container extracts
# documents, the web container runs the sidebar chat — or half the traffic still
# goes direct. This is an ORIGIN: "/v1/messages" is appended, unlike
# FIBUKI_AI_BASE_URL below, which is an OpenAI-shaped root that includes "/v1".
# FIBUKI_ANTHROPIC_BASE_URL=http://litellm:4000

# Fully local option — nothing leaves the machine, no key to leak. This is the
# only configuration where customer invoice content is not sent to a third party,
# which for Austrian tax data may be the deciding factor for a self-hoster.
# FIBUKI_AI_PROVIDER=openai-compatible
# FIBUKI_AI_BASE_URL=http://ollama:11434/v1
# FIBUKI_AI_API_KEY=
