rules_version = '2';

// Frozen rollback anchor, as firestore.rules explains: the retained Firebase
// project serves no client, so no client reads or writes its bucket. The
// Admin SDK is not subject to these rules. A rollback restores the
// pre-cutover rules from git history.

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
