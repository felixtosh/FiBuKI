# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# No trailing slash: a git worktree that symlinks node_modules at the repo root
# and at functions/ (the usual way to avoid a second npm ci) creates a SYMLINK,
# not a directory, and "node_modules/" does not match one. Those symlinks then
# show up as untracked and get swept into a commit by `git add -A`.
node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Firebase
.firebase/
functions/lib/
firebase-debug.log
firestore-debug.log
ui-debug.log
storage-debug.log
*.secret.local

# Emulator data
emulator-data/

# Claude Code
# Personal config stays local; shared team config + safety hooks are committed,
# so they actually reach contributors (a gitignored guard guards nobody).
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/commands/
.claude/settings.local.json

# MCP config
.mcp.json

# VSCode
.vscode/

# Node version
.node-version

# Firebase RC
.firebaserc

# Screenshots
Screenshot*.png

# Internal planning docs
PLAN-*.md

# Separate npm packages (published independently)
/mcp-server/
.gstack/

# Migration dumps contain real customer data — never commit one.
# The runbook uses ./fibuki-dump; ignore it wherever it lands.
fibuki-dump/
**/fibuki-dump/
