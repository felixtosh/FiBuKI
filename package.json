{
  "name": "taxstudio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "predev": "node scripts/copy-pdfjs-wasm.mjs",
    "dev": "next dev",
    "dev:emulators": "dotenv -e .env.local -- firebase emulators:start",
    "dev:all": "concurrently \"npm run dev:emulators\" \"npm run dev\"",
    "prebuild": "node scripts/copy-pdfjs-wasm.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:strings": "node scripts/check-ui-strings.mjs",
    "lint:design-system": "node scripts/check-design-system.mjs",
    "test:chat-url": "node --test tests/chat-url-state.test.mjs",
    "test:file-filters": "node --test tests/apply-file-filters.test.mjs",
    "test:file-url-params": "node --test tests/file-url-params.test.mjs",
    "test:bulk-file-selection": "node --test tests/bulk-file-selection.test.mjs",
    "test:row-neighbour": "node --test tests/row-neighbour.test.mjs",
    "test:arrow-keys": "node --test tests/arrow-key-navigation.test.mjs",
    "test:partner-url-params": "node --test tests/partner-url-params.test.mjs",
    "test:billing-cycle": "node --test tests/billing-cycle-presentation.test.mjs",
    "test:document-type": "node --test tests/document-type-presentation.test.mjs",
    "test:file-kind": "node --test tests/file-kind.test.mjs",
    "test:delete-confirmation": "node --test tests/delete-confirmation.test.mjs",
    "test:merge-preview": "node --test tests/merge-preview.test.mjs",
    "test:latest-callback": "node --test tests/latest-callback.test.mjs",
    "test:files-upload-pipeline": "node --test tests/files-upload-pipeline.test.mjs",
    "test:node": "node --test tests/*.test.mjs",
    "test:components": "vitest run --config vitest.components.config.ts",
    "test:components:watch": "vitest --config vitest.components.config.ts",
    "setup": "bash scripts/setup.sh",
    "generate:mcp-automations": "node scripts/generate-mcp-automations.js",
    "check:corpus-anchors": "node scripts/check-corpus-anchors.js"
  },
