                    "type": "object",
                    "properties": {
                      "payload": {
                        "type": "string"
                      },
                      "decodedBy": {
                        "description": "\"barcode\" when a barcode decoder read the payload, \"model\" when a model transcribed it. Absent means \"model\".",
