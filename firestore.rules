rules_version = '2';

// The retained Firebase project (taxstudio-f12fb) is the frozen rollback
// anchor of the W4 cutover (docs/w4-cutover-runbook.md): it holds the
// pre-cutover copy of customer data and serves no client. fibuki.com runs the
// self-host stack, where access rules live in
// functions/src/selfhost/data-policy.ts.
//
// So no client may read or write anything here. The Admin SDK (export,
// verification, a rollback import) is not subject to these rules.
//
// Rolling back to Firebase means restoring the pre-cutover rules from git
// history (`git log -- firestore.rules`) as part of the rollback, not before.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
